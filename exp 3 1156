                <p>Timeless Treasures</p>
            </div>
            <div class="card">
                <img src="C:\Users\Rhenius\Downloads\2.png" alt="Sci-Fi">
                <h3>Sci-Fi & Fantasy</h3>
                <p>Alternative Worlds</p>
            </div>
            <div class="card">
                <img src="C:\Users\Rhenius\Downloads\3.jpg" alt="Croissants">
                <h3>Butter Croissants</h3>
                <p>Warm Bakery Treat</p>
            </div>
            <div class="card">
                <img src="C:\Users\Rhenius\Downloads\4.jpg" alt="Teas">
                <h3>Artisan Teas</h3>
                <p>Herbal Blends</p>
            </div>
            <div class="card">
                <img src="C:\Users\Rhenius\Downloads\5.jpg" alt="New Books">
                <h3>New Releases</h3>
                <p>Weekly Bestsellers</p>
            </div>
        </div>
    </section>

    <section>
        <h2>Why Choose Us?</h2>
        <ul>
            <li>📖 Handpicked Book Selection</li>
